# cPanel Deployer - Root .htaccess
Options -Indexes
DirectoryIndex index.php index.html index.htm
AddDefaultCharset UTF-8

# Block access to hidden files and sensitive extensions
<FilesMatch "^\.(?!well-known)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(json|log|lock|ini|env|sh|bak|swp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block internal panel directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^panel_core(/|$) - [F,L]
    RewriteRule ^panel_data(/|$) - [F,L]
</IfModule>
